# Local development only. For VPS use sh manage production-init instead.
# Credentials and account-specific values first; never commit real secrets.

POSTGRES_PASSWORD=change-local-database-password
NATS_PASSWORD=mailer-development
EVENT_INGEST_TOKEN=development-event-token-change-me
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WEBHOOK_SIGNING_MASTER_KEY=development-webhook-master-key-change-me
API_AWS_ACCESS_KEY_ID=
API_AWS_SECRET_ACCESS_KEY=
API_AWS_SESSION_TOKEN=
WORKER_AWS_ACCESS_KEY_ID=
WORKER_AWS_SECRET_ACCESS_KEY=
WORKER_AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
# Existing SES configuration set with SNS event publishing enabled.
SES_CONFIGURATION_SET=
# Verified SES sender used only for account password-reset emails.
ACCOUNT_EMAIL_FROM=
SES_EVENTS_QUEUE_URL=
SES_EVENTS_TOPIC_ARN=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Runtime defaults (local HTTP, providers disabled)
APP_ENV=development
HTTP_ADDR=0.0.0.0:8080
CONSOLE_ORIGIN=http://localhost:8081
INTERNAL_API_URL=http://api:8080
RUST_LOG=info,sqlx=warn
FRONTEND_PORT=8081
VITE_API_URL=http://localhost:8080
POSTGRES_USER=mailer
POSTGRES_DB=mailer
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
NATS_USER=mailer
NATS_URL=nats://${NATS_USER}:${NATS_PASSWORD}@nats:4222
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECONDS=5
DOMAIN_PROVIDER=disabled
OBJECT_STORAGE_PROVIDER=disabled
OBJECT_STORAGE_REGION=auto
EMAIL_CONTENT_RETENTION_DAYS=30
API_KEY_RATE_LIMIT_PER_MINUTE=60
CLIENT_IP_RATE_LIMIT_PER_MINUTE=300
TRUST_PROXY_HEADERS=false
WORKSPACE_MONTHLY_EMAIL_LIMIT=100000
WORKSPACE_CONCURRENT_EMAIL_LIMIT=100
