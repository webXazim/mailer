#!/bin/sh
set -eu

cd "$(dirname "$0")"

usage() {
    cat <<'EOF'
Usage: sh manage COMMAND

Commands:
  install             Install frontend dependencies
  dev                 Build and start the complete local Docker stack
  down                Stop the local Docker stack
  logs                Follow all Docker service logs
  frontend-dev        Run the Vite development server
  frontend-build      Build the frontend
  backend-fmt         Check Rust formatting
  backend-lint        Run strict Rust Clippy
  backend-test        Run Rust tests
  check               Verify frontend and backend
  compose-config      Validate local Compose configuration
  production-init     Create .env with generated local secrets (never overwrite)
  deploy              Validate, build on the VPS, and start production services
  preflight           Validate production configuration
  production-pull     Pull infrastructure images (not the locally built app)
  production-up       Alias for deploy
  production-down     Stop production services
  production-logs     Follow production logs
  production-status   Show production services and assigned localhost port
  pending-workspaces  List public signups waiting for production approval
  approve-workspace   Enable production sending for a workspace UUID
  healthcheck         Check the public console, API, and private-route blocking
  backup              Run an encrypted PostgreSQL backup
  restore-rehearsal   Restore the latest backup into a disposable database
EOF
}

load_environment() {
    test -f .env || { echo ".env is required" >&2; exit 1; }
    set -a
    . ./.env
    set +a
}

production_compose() {
    # Use the same file values preflight validates, even if the login shell has
    # exported similarly named variables for another application on this VPS.
    load_environment
    docker compose --project-name crescentsphere-mailer --env-file .env -f docker-compose.production.yml "$@"
}

command=${1:-help}
case "$command" in
    help|-h|--help) usage ;;
    install) npm --prefix frontend ci ;;
    dev) docker compose up --build ;;
    down) docker compose down ;;
    logs) docker compose logs --follow ;;
    frontend-dev) npm --prefix frontend run dev -- --host 0.0.0.0 ;;
    frontend-build) npm --prefix frontend run build ;;
    backend-fmt) cargo fmt --manifest-path backend/Cargo.toml --all --check ;;
    backend-lint) cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings ;;
    backend-test) cargo test --manifest-path backend/Cargo.toml --workspace ;;
    check)
        sh "$0" frontend-build
        sh "$0" backend-fmt
        sh "$0" backend-lint
        sh "$0" backend-test
        ;;
    compose-config) docker compose config --quiet ;;
    production-init) sh backend/deploy/init-env.sh ;;
    preflight) sh backend/deploy/preflight.sh ;;
    production-pull)
        production_compose pull postgres nats cloudflared
        ;;
    deploy|production-up)
        sh backend/deploy/preflight.sh
        # Build before replacing running containers. Limit concurrent build work.
        COMPOSE_PARALLEL_LIMIT=1 production_compose build api worker frontend
        production_compose up -d --no-build --wait --wait-timeout 180
        # cloudflared's minimal image has no shell/curl; probe from nginx.
        if ! production_compose exec -T frontend sh -c '
            attempt=0
            until wget -qO /dev/null http://cloudflared:2000/ready; do
                attempt=$((attempt + 1))
                [ "$attempt" -lt 15 ] || exit 1
                sleep 2
            done'; then
            echo 'Services started, but the tunnel is not ready. Check: sh manage production-logs cloudflared' >&2
            exit 1
        fi
        production_compose ps
        printf '\nLocal console address: '
        production_compose port api 8081
        echo 'Tunnel connected. Verify the public route with: sh manage healthcheck'
        ;;
    production-down)
        production_compose down
        ;;
    production-logs)
        shift
        production_compose logs --follow --tail 100 "$@"
        ;;
    production-status)
        production_compose ps
        production_compose port api 8081
        ;;
    pending-workspaces)
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --no-align --field-separator=' | ' --command "SELECT w.id,u.email,w.name,w.created_at FROM workspaces w JOIN users u ON u.id=w.created_by WHERE NOT w.production_enabled ORDER BY w.created_at;"
        ;;
    approve-workspace)
        shift
        workspace_id=${1:-}
        printf '%s\n' "$workspace_id" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || { echo 'Usage: sh manage approve-workspace WORKSPACE_UUID' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "UPDATE workspaces SET production_enabled=true,updated_at=now() WHERE id='$workspace_id'::uuid;"
        ;;
    healthcheck)
        load_environment
        sh backend/deploy/healthcheck.sh
        ;;
    backup)
        load_environment
        bash backend/deploy/backup.sh
        ;;
    restore-rehearsal)
        load_environment
        sh backend/deploy/restore-rehearsal.sh
        ;;
    *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
