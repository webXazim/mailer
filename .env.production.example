# CrescentSphere Mailer production environment
# Store as /opt/crescentsphere-mailer/.env with mode 0600. Never commit the real file.

APP_ENV=production
HTTP_ADDR=0.0.0.0:8080
CONSOLE_ORIGIN=https://mailer.crescentsphere.com
INTERNAL_API_URL=http://api:8080
RUST_LOG=info,sqlx=warn
API_PORT=8080
FRONTEND_PORT=8081
VITE_API_URL=https://api.mailer.crescentsphere.com

POSTGRES_USER=mailer
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=mailer
DATABASE_URL=postgres://mailer:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/mailer
NATS_USER=mailer
NATS_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD
NATS_URL=nats://mailer:REPLACE_WITH_URL_ENCODED_NATS_PASSWORD@nats:4222
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=30
DB_ACQUIRE_TIMEOUT_SECONDS=5

EVENT_INGEST_TOKEN=REPLACE_WITH_OPENSSL_RAND_BASE64_48
WEBHOOK_SIGNING_MASTER_KEY=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_BASE64_48

AWS_REGION=me-south-1
DOMAIN_PROVIDER=ses
# VPS deployment: separate least-privilege IAM users. Do not use the AWS root account.
API_AWS_ACCESS_KEY_ID=REPLACE_WITH_API_IAM_ACCESS_KEY
API_AWS_SECRET_ACCESS_KEY=REPLACE_WITH_API_IAM_SECRET_KEY
API_AWS_SESSION_TOKEN=
WORKER_AWS_ACCESS_KEY_ID=REPLACE_WITH_WORKER_IAM_ACCESS_KEY
WORKER_AWS_SECRET_ACCESS_KEY=REPLACE_WITH_WORKER_IAM_SECRET_KEY
WORKER_AWS_SESSION_TOKEN=
SES_EVENTS_QUEUE_URL=https://sqs.me-south-1.amazonaws.com/ACCOUNT_ID/crescentsphere-mailer-events
SES_EVENTS_TOPIC_ARN=arn:aws:sns:me-south-1:ACCOUNT_ID:crescentsphere-mailer-events

OBJECT_STORAGE_PROVIDER=r2
# Cloudflare R2:
OBJECT_STORAGE_ENDPOINT=https://CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=crescentsphere-mailer-production
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
EMAIL_CONTENT_RETENTION_DAYS=30
API_KEY_RATE_LIMIT_PER_MINUTE=120
CLIENT_IP_RATE_LIMIT_PER_MINUTE=600
TRUST_PROXY_HEADERS=true
WORKSPACE_MONTHLY_EMAIL_LIMIT=100000
WORKSPACE_CONCURRENT_EMAIL_LIMIT=500

# Images published by CI. Use immutable version or digest, not latest.
API_IMAGE=ghcr.io/crescentsphere/mailer-api:REPLACE_VERSION
WORKER_IMAGE=ghcr.io/crescentsphere/mailer-worker:REPLACE_VERSION
FRONTEND_IMAGE=ghcr.io/crescentsphere/mailer-frontend:REPLACE_VERSION
IMAGE_TAG=REPLACE_VERSION

# Encrypted offsite backups. Install age and rclone on the VPS.
BACKUP_DIR=/var/backups/crescentsphere-mailer
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=/root/.config/age/crescentsphere-mailer.key
BACKUP_RCLONE_REMOTE=REPLACE_REMOTE:crescentsphere-mailer-production
BACKUP_RETENTION_DAYS=14
ALERT_WEBHOOK_URL=
PUBLIC_CONSOLE_URL=https://mailer.crescentsphere.com
