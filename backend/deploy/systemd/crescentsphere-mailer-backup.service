[Unit]
Description=CrescentSphere Mailer encrypted PostgreSQL backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/crescentsphere-mailer
EnvironmentFile=/opt/crescentsphere-mailer/.env
ExecStart=/opt/crescentsphere-mailer/backend/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
