{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendFromVerifiedMailerIdentities",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:ap-southeast-1:ACCOUNT_ID:identity/*",
        "arn:aws:ses:ap-southeast-1:ACCOUNT_ID:configuration-set/CONFIGURATION_SET_NAME"
      ]
    },
    {
      "Sid": "ConsumeMailerEvents",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-southeast-1:ACCOUNT_ID:crescentsphere-mailer-events"
    }
  ]
}
