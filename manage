#!/bin/sh
set -eu

cd "$(dirname "$0")"

usage() {
    cat <<'EOF'
Usage: sh manage COMMAND

Commands:
  install             Install frontend dependencies
  dev                 Build and start the complete local Docker stack
  down                Stop the local Docker stack
  logs                Follow all Docker service logs
  frontend-dev        Run the Vite development server
  frontend-build      Build the frontend
  backend-fmt         Check Rust formatting
  backend-lint        Run strict Rust Clippy
  backend-test        Run Rust tests
  check               Verify frontend and backend
  compose-config      Validate local Compose configuration
  production-init     Create .env with generated local secrets (never overwrite)
  deploy              Validate, build on the VPS, and start production services
  preflight           Validate production configuration
  production-pull     Pull infrastructure images (not the locally built app)
  production-up       Alias for deploy
  production-down     Stop production services
  production-logs     Follow production logs
  production-status   Show production services and assigned localhost port
  pending-workspaces  List workspaces without production access
  approve-workspace   Manually enable production for a workspace UUID
  pause-workspace ID  Pause production admission and provider attempts
  resume-workspace ID Resume production after investigation and key rotation
  security-events [DAYS] Show containment and operator security events
  account-email-status Show auth-email and downstream SES status for an address
  delivery-routing-status Show provider controls, cohorts, and today's volume
  smtp-pause          Stop new SMTP attempts; safely defer or roll back queued mail
  smtp-resume         Allow SMTP attempts for configured cohorts
  smtp-cap NUMBER     Set the global daily SMTP admission cap
  ses-rollback MODE   Enable or disable pre-attempt SES rollback (enable|disable)
  route-workspace ID PROVIDER Route a workspace to ses, smtp, or default
  delivery-report [DAYS] Show provider/domain outcomes (default: 7 days)
  healthcheck         Check the public console, API, and private-route blocking
  backup              Run an encrypted PostgreSQL backup
  restore-rehearsal   Restore the latest backup into a disposable database
  stalwart-init       Create .env.stalwart with a recovery credential
  stalwart-preflight  Validate the independent Stalwart Compose configuration
  stalwart-network-check Verify forward DNS, PTR, and outbound IPv4 SMTP
  stalwart-up         Pull and start the independent Stalwart service
  stalwart-down       Stop Stalwart while preserving its named volumes
  stalwart-restart    Restart only the independent Stalwart service
  stalwart-logs       Follow Stalwart logs
  stalwart-status     Show Stalwart service status and admin port
  storage-init        Create private Garage configuration and secrets
  storage-preflight   Validate the independent Garage configuration
  storage-up          Pull and start the independent Garage object store
  storage-bootstrap   Create the initial layout, bucket, and application key
  storage-down        Stop Garage while preserving its named volumes
  storage-restart     Restart only the independent Garage service
  storage-logs        Follow Garage logs
  storage-status      Show Garage health and its loopback S3 port
EOF
}

load_environment() {
    test -f .env || { echo ".env is required" >&2; exit 1; }
    set -a
    . ./.env
    set +a
}

production_compose() {
    # Use the same file values preflight validates, even if the login shell has
    # exported similarly named variables for another application on this VPS.
    load_environment
    docker compose --project-name crescentsphere-mailer --env-file .env -f docker-compose.production.yml "$@"
}

stalwart_compose() {
    test -f .env.stalwart || { echo ".env.stalwart is required; run: sh manage stalwart-init" >&2; exit 1; }
    docker compose --project-name crescentsphere-stalwart --env-file .env.stalwart -f docker-compose.stalwart.yml "$@"
}

storage_compose() {
    test -f .env.storage || { echo ".env.storage is required; run: sh manage storage-init" >&2; exit 1; }
    docker compose --project-name crescentsphere-storage --env-file .env.storage -f docker-compose.storage.yml "$@"
}

command=${1:-help}
case "$command" in
    help|-h|--help) usage ;;
    install) npm --prefix frontend ci ;;
    dev) docker compose up --build ;;
    down) docker compose down ;;
    logs) docker compose logs --follow ;;
    frontend-dev) npm --prefix frontend run dev -- --host 0.0.0.0 ;;
    frontend-build) npm --prefix frontend run build ;;
    backend-fmt) cargo fmt --manifest-path backend/Cargo.toml --all --check ;;
    backend-lint) cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings ;;
    backend-test) cargo test --manifest-path backend/Cargo.toml --workspace ;;
    check)
        sh "$0" frontend-build
        sh "$0" backend-fmt
        sh "$0" backend-lint
        sh "$0" backend-test
        ;;
    compose-config) docker compose config --quiet ;;
    production-init) sh backend/deploy/init-env.sh ;;
    preflight) sh backend/deploy/preflight.sh ;;
    production-pull)
        production_compose pull postgres nats cloudflared
        ;;
    deploy|production-up)
        sh backend/deploy/preflight.sh
        # Build before replacing running containers. Limit concurrent build work.
        COMPOSE_PARALLEL_LIMIT=1 production_compose build api worker frontend
        production_compose up -d --no-build --wait --wait-timeout 180
        # cloudflared's minimal image has no shell/curl; probe from nginx.
        if ! production_compose exec -T frontend sh -c '
            attempt=0
            until wget -qO /dev/null http://cloudflared:2000/ready; do
                attempt=$((attempt + 1))
                [ "$attempt" -lt 15 ] || exit 1
                sleep 2
            done'; then
            echo 'Services started, but the tunnel is not ready. Check: sh manage production-logs cloudflared' >&2
            exit 1
        fi
        production_compose ps
        printf '\nLocal console address: '
        production_compose port api 8081
        echo 'Tunnel connected. Verify the public route with: sh manage healthcheck'
        ;;
    production-down)
        production_compose down
        ;;
    production-logs)
        shift
        production_compose logs --follow --tail 100 "$@"
        ;;
    production-status)
        production_compose ps
        production_compose port api 8081
        ;;
    pending-workspaces)
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --no-align --field-separator=' | ' --command "SELECT w.id,u.email,w.name,w.created_at FROM workspaces w JOIN users u ON u.id=w.created_by WHERE NOT w.production_enabled ORDER BY w.created_at;"
        ;;
    approve-workspace)
        shift
        workspace_id=${1:-}
        printf '%s\n' "$workspace_id" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || { echo 'Usage: sh manage approve-workspace WORKSPACE_UUID' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "UPDATE workspaces SET production_enabled=true,updated_at=now() WHERE id='$workspace_id'::uuid;"
        ;;
    pause-workspace)
        shift
        workspace_id=${1:-}
        printf '%s\n' "$workspace_id" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || { echo 'Usage: sh manage pause-workspace WORKSPACE_UUID' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "BEGIN; UPDATE workspaces SET sending_paused_at=COALESCE(sending_paused_at,now()),sending_pause_reason=COALESCE(sending_pause_reason,'manual_operator_pause'),sending_paused_by=COALESCE(sending_paused_by,'operator'),updated_at=now() WHERE id='$workspace_id'::uuid; INSERT INTO audit_events(workspace_id,action,resource_type,resource_id,metadata) SELECT id,'security.workspace_paused','workspace',id,jsonb_build_object('source','operator') FROM workspaces WHERE id='$workspace_id'::uuid; COMMIT;"
        ;;
    resume-workspace)
        shift
        workspace_id=${1:-}
        printf '%s\n' "$workspace_id" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || { echo 'Usage: sh manage resume-workspace WORKSPACE_UUID' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "BEGIN; UPDATE workspaces SET sending_paused_at=NULL,sending_pause_reason=NULL,sending_paused_by=NULL,updated_at=now() WHERE id='$workspace_id'::uuid; INSERT INTO audit_events(workspace_id,action,resource_type,resource_id,metadata) SELECT id,'security.workspace_resumed','workspace',id,jsonb_build_object('source','operator') FROM workspaces WHERE id='$workspace_id'::uuid; INSERT INTO outbox_events(aggregate_type,aggregate_id,event_type,payload) SELECT 'email',email.id,'email.accepted',jsonb_build_object('emailId',email.id,'workspaceId',email.workspace_id) FROM emails email WHERE email.workspace_id='$workspace_id'::uuid AND email.environment='production' AND email.status='queued' AND NOT EXISTS(SELECT 1 FROM delivery_provider_attempts attempt WHERE attempt.email_id=email.id); COMMIT;"
        ;;
    security-events)
        shift
        days=${1:-7}
        printf '%s\n' "$days" | grep -Eq '^[1-9][0-9]*$' || { echo 'Usage: sh manage security-events [POSITIVE_DAYS]' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "SELECT event.created_at,event.workspace_id,workspace.name,event.action,event.resource_type,event.resource_id,event.metadata FROM audit_events event LEFT JOIN workspaces workspace ON workspace.id=event.workspace_id WHERE event.action LIKE 'security.%' AND event.created_at>=now()-make_interval(days=>$days) ORDER BY event.created_at DESC;"
        ;;
    account-email-status)
        shift
        recipient=${1:-}
        test -n "$recipient" || { echo "Usage: sh manage account-email-status EMAIL" >&2; exit 2; }
        load_environment
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=recipient="$recipient" --variable=ON_ERROR_STOP=1 <<'SQL'
\x auto
SELECT
    account_email.updated_at AS last_updated_at,
    account_email.status AS auth_status,
    account_email.attempts AS auth_attempts,
    account_email.last_error AS auth_error,
    mail.status AS delivery_status,
    mail.processing_attempts AS delivery_attempts,
    mail.last_error AS delivery_error,
    latest_event.event_type AS latest_event,
    latest_event.occurred_at AS event_time,
    account_email.mailer_email_id
FROM account_emails account_email
LEFT JOIN emails mail ON mail.id = account_email.mailer_email_id
LEFT JOIN LATERAL (
    SELECT event_type, occurred_at
    FROM delivery_events
    WHERE email_id = mail.id
    ORDER BY occurred_at DESC
    LIMIT 1
) latest_event ON true
WHERE lower(account_email.recipient) = lower(:'recipient')
ORDER BY account_email.updated_at DESC
LIMIT 10;
SQL
        ;;
    delivery-routing-status)
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 <<'SQL'
SELECT smtp_paused,smtp_daily_email_limit,ses_rollback_enabled,updated_at FROM delivery_operator_controls WHERE singleton=true;
SELECT usage_date,provider,emails_admitted FROM delivery_provider_daily_usage WHERE usage_date>=current_date-7 ORDER BY usage_date DESC,provider;
SELECT route.workspace_id,workspace.name,route.provider,route.updated_at FROM workspace_delivery_routes route JOIN workspaces workspace ON workspace.id=route.workspace_id ORDER BY route.updated_at DESC;
SELECT action,details,created_at FROM delivery_control_audit ORDER BY created_at DESC LIMIT 20;
SQL
        ;;
    smtp-pause|smtp-resume)
        paused=true
        test "$command" = smtp-resume && paused=false
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "BEGIN; SELECT pg_advisory_xact_lock(hashtextextended('delivery-routing-control',0)); UPDATE delivery_operator_controls SET smtp_paused=$paused,updated_at=now() WHERE singleton=true; INSERT INTO delivery_control_audit(action,details) VALUES('smtp-pause',jsonb_build_object('paused',$paused)); COMMIT;"
        ;;
    smtp-cap)
        shift
        limit=${1:-}
        printf '%s\n' "$limit" | grep -Eq '^[1-9][0-9]*$' || { echo 'Usage: sh manage smtp-cap POSITIVE_NUMBER' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "BEGIN; UPDATE delivery_operator_controls SET smtp_daily_email_limit=$limit,updated_at=now() WHERE singleton=true; INSERT INTO delivery_control_audit(action,details) VALUES('smtp-cap',jsonb_build_object('limit',$limit)); COMMIT;"
        ;;
    ses-rollback)
        shift
        mode=${1:-}
        case "$mode" in enable) enabled=true ;; disable) enabled=false ;; *) echo 'Usage: sh manage ses-rollback enable|disable' >&2; exit 2 ;; esac
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "BEGIN; SELECT pg_advisory_xact_lock(hashtextextended('delivery-routing-control',0)); UPDATE delivery_operator_controls SET ses_rollback_enabled=$enabled,updated_at=now() WHERE singleton=true; INSERT INTO delivery_control_audit(action,details) VALUES('ses-rollback',jsonb_build_object('enabled',$enabled)); COMMIT;"
        ;;
    route-workspace)
        shift
        workspace_id=${1:-}
        provider=${2:-}
        printf '%s\n' "$workspace_id" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || { echo 'Usage: sh manage route-workspace WORKSPACE_UUID ses|smtp|default' >&2; exit 2; }
        case "$provider" in
            ses|smtp) sql="BEGIN; INSERT INTO workspace_delivery_routes(workspace_id,provider) VALUES('$workspace_id'::uuid,'$provider') ON CONFLICT(workspace_id) DO UPDATE SET provider=EXCLUDED.provider,updated_at=now(); INSERT INTO delivery_control_audit(action,details) VALUES('workspace-route',jsonb_build_object('workspaceId','$workspace_id','provider','$provider')); COMMIT;" ;;
            default) sql="BEGIN; DELETE FROM workspace_delivery_routes WHERE workspace_id='$workspace_id'::uuid; INSERT INTO delivery_control_audit(action,details) VALUES('workspace-route',jsonb_build_object('workspaceId','$workspace_id','provider','default')); COMMIT;" ;;
            *) echo 'Usage: sh manage route-workspace WORKSPACE_UUID ses|smtp|default' >&2; exit 2 ;;
        esac
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "$sql"
        ;;
    delivery-report)
        shift
        days=${1:-7}
        printf '%s\n' "$days" | grep -Eq '^[1-9][0-9]*$' || { echo 'Usage: sh manage delivery-report [POSITIVE_DAYS]' >&2; exit 2; }
        production_compose exec -T postgres psql --username "${POSTGRES_USER:-mailer}" --dbname "${POSTGRES_DB:-mailer}" --variable=ON_ERROR_STOP=1 --command "SELECT email.delivery_provider AS provider,split_part(lower(recipient.address),'@',2) AS recipient_domain,event.event_type,count(*) AS events FROM delivery_events event JOIN emails email ON email.id=event.email_id LEFT JOIN email_recipients recipient ON recipient.email_id=email.id AND lower(recipient.address)=lower(event.recipient) WHERE event.occurred_at>=now()-make_interval(days=>$days) GROUP BY 1,2,3 ORDER BY 1,2,3;"
        ;;
    healthcheck)
        load_environment
        sh backend/deploy/healthcheck.sh
        ;;
    backup)
        load_environment
        bash backend/deploy/backup.sh
        ;;
    restore-rehearsal)
        load_environment
        sh backend/deploy/restore-rehearsal.sh
        ;;
    stalwart-init)
        sh stalwart/deploy/init-env.sh
        ;;
    stalwart-preflight)
        sh stalwart/deploy/preflight.sh
        ;;
    stalwart-network-check)
        sh stalwart/deploy/network-check.sh
        ;;
    stalwart-up)
        sh stalwart/deploy/preflight.sh
        stalwart_compose pull stalwart
        stalwart_compose up -d
        stalwart_compose ps
        echo "Admin UI is loopback-only. See STALWART_DEPLOYMENT.md for SSH tunneling."
        ;;
    stalwart-down)
        stalwart_compose down
        ;;
    stalwart-restart)
        stalwart_compose restart stalwart
        ;;
    stalwart-logs)
        stalwart_compose logs --follow --tail 100 stalwart
        ;;
    stalwart-status)
        stalwart_compose ps
        printf '\nLoopback admin address: '
        stalwart_compose port stalwart 8080
        ;;
    storage-init) sh backend/deploy/storage-init.sh ;;
    storage-preflight) sh backend/deploy/storage-preflight.sh ;;
    storage-up)
        sh backend/deploy/storage-preflight.sh
        storage_compose pull garage
        storage_compose up -d --wait --wait-timeout 120 garage
        storage_compose ps
        ;;
    storage-bootstrap) sh backend/deploy/storage-bootstrap.sh ;;
    storage-down) storage_compose down ;;
    storage-restart) storage_compose restart garage ;;
    storage-logs) storage_compose logs --follow --tail 100 garage ;;
    storage-status)
        storage_compose ps
        storage_compose exec -T garage /garage status
        printf '\nLoopback S3 address: '
        storage_compose port garage 3900
        ;;
    *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
