{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageMailerIdentities",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:DeleteEmailIdentity",
        "ses:GetEmailIdentity",
        "ses:PutEmailIdentityMailFromAttributes"
      ],
      "Resource": "arn:aws:ses:me-south-1:ACCOUNT_ID:identity/*"
    }
  ]
}
