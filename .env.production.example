# VPS testing and production: copy to .env, chmod 600, NEVER commit.
# sh manage production-init generates the four local secrets automatically.
# Values must be shell-compatible; single-quote credentials containing $ or #.

# === ENTER YOUR CREDENTIALS / ACCOUNT VALUES HERE ===
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare Dashboard > Turnstile. Site key is public; secret key stays here.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare > Manage Account > OAuth clients. Use a public server-side client.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
API_AWS_ACCESS_KEY_ID=
API_AWS_SECRET_ACCESS_KEY=
API_AWS_SESSION_TOKEN=
WORKER_AWS_ACCESS_KEY_ID=
WORKER_AWS_SECRET_ACCESS_KEY=
WORKER_AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
# Existing SES configuration set with SNS event publishing enabled.
SES_CONFIGURATION_SET=
# Live Mailer key with emails:send, used for verification and password-reset email.
ACCOUNT_EMAIL_API_KEY=
# From address under a verified sending domain, for example:
ACCOUNT_EMAIL_FROM='CrescentSphere Mailer <no-reply@mailer.crescentsphere.com>'
SES_EVENTS_QUEUE_URL=
SES_EVENTS_TOPIC_ARN=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Generated by production-init. If copying manually use openssl rand -hex 32
# separately for each value. Database/NATS passwords must be URL-safe hex.
# Keep these stable across redeployments; changing .env does not rotate a DB.
POSTGRES_PASSWORD=
NATS_PASSWORD=
EVENT_INGEST_TOKEN=
WEBHOOK_SIGNING_MASTER_KEY=

# Optional encrypted offsite backup / alert credentials (required before launch).
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_RCLONE_REMOTE=
ALERT_WEBHOOK_URL=

# === DEFAULTS: normally no edits below this line ===
APP_ENV=production
# Enable after ACCOUNT_EMAIL_API_KEY and ACCOUNT_EMAIL_FROM are configured.
AUTH_EMAIL_DELIVERY_ENABLED=true
CONSOLE_ORIGIN=https://mailer.crescentsphere.com
PUBLIC_CONSOLE_URL=https://mailer.crescentsphere.com
PUBLIC_API_URL=https://mailer.crescentsphere.com/api
DOMAIN_PROVIDER=ses
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_REGION=auto
TRUST_PROXY_HEADERS=true
RUST_LOG=info,sqlx=warn
CLOUDFLARE_OAUTH_SCOPES=zone.read dns.write

POSTGRES_USER=mailer
POSTGRES_DB=mailer
NATS_USER=mailer
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECONDS=5

# Zero asks Docker for a free loopback port; cloudflared uses api:8081 directly.
# For a fixed localhost port, set a verified free port such as 18081.
FRONTEND_PORT=0
IMAGE_TAG=local
# Pin a reviewed version/digest before customer production; latest for testing.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Limit Rust compile concurrency on the shared VPS. Builds need extra RAM/disk.
CARGO_BUILD_JOBS=1
API_MEMORY_LIMIT=384m
WORKER_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=512m
NATS_MEMORY_LIMIT=256m
FRONTEND_MEMORY_LIMIT=64m
CLOUDFLARED_MEMORY_LIMIT=128m

EMAIL_CONTENT_RETENTION_DAYS=30
API_KEY_RATE_LIMIT_PER_MINUTE=60
CLIENT_IP_RATE_LIMIT_PER_MINUTE=300
WORKSPACE_MONTHLY_EMAIL_LIMIT=100000
WORKSPACE_CONCURRENT_EMAIL_LIMIT=100
BACKUP_DIR=/var/backups/crescentsphere-mailer
BACKUP_RETENTION_DAYS=14
