# Copy with `sh manage stalwart-init`. Never commit the generated file.
# Pin a reviewed release. A full image digest may replace the minor tag later.
STALWART_IMAGE=stalwartlabs/stalwart:v0.16
STALWART_ADMIN_PORT=8088
STALWART_PUBLIC_URL=https://smtp.crescentsphere.com

# Generated by stalwart-init. Format: username:strong-password
STALWART_RECOVERY_ADMIN=

# Used by preflight checks; it is not passed to Stalwart.
STALWART_HOSTNAME=smtp.crescentsphere.com
STALWART_IPV4=152.53.178.165

